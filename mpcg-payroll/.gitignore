# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & scratch scripts
/scratch/
/scratch/*
check-*.ts
test-*.ts

# logs & debug files
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
realtime-debug-log.txt
*.txt

# next.js & production builds
/.next/
/out/
/build

# environment files
.env
.env.*
!.env.example

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pem

# typescript build cache
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# generated PDFs and salary slips
*.pdf
/salary-slips/
/public/salary-slips/
