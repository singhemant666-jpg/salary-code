# MPCG Payroll System — Environment Variables Template for EC2 / Production

# Database — Update with your MySQL credentials on EC2
# Example: mysql://username:password@127.0.0.1:3306/mpcg_payroll
DATABASE_URL="mysql://root:@127.0.0.1:3306/mpcg_payroll"

# NextAuth Secret — Run `openssl rand -hex 32` or keep this random string
AUTH_SECRET="mpcg-payroll-secret-key-change-in-production-2026"
AUTH_TRUST_HOST="true"

# Allowed Origins — Add your EC2 public IP or domain here (comma-separated)
# Example: ALLOWED_ORIGINS="54.210.12.34:3000,54.210.12.34,payroll.yourdomain.com"
ALLOWED_ORIGINS="localhost:3000,127.0.0.1:3000"

# Optional: NextAuth URL (only set if using a custom domain or reverse proxy with SSL)
# NEXTAUTH_URL="https://payroll.yourdomain.com"

# Sensitive Credentials for Email & WhatsApp
GUPSHUP_API_KEY=""
SMTP_USER="payoutmypainclinicglobal@gmail.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="payoutmypainclinicglobal@gmail.com"
