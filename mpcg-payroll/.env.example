# MPCG Payroll System — Production Environment Variables
# Copy this file to .env and configure for your AWS / Production environment

# 1. Environment Flag
NODE_ENV=production

# 2. Production Database Connection String (MySQL 8.0+)
# Replace username, password, host, port, and database name
DATABASE_URL="mysql://mpcg_user:YourSecurePassword123!@127.0.0.1:3306/mpcg_payroll?connection_limit=10"

# 3. NextAuth Authentication Configuration
# Generate a 32+ character random string: openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-this-in-production-at-least-32-chars"
AUTH_TRUST_HOST="true"

# 4. Production Application URL (Domain or Public IP)
NEXTAUTH_URL="https://yourdomain.com"

# 5. WhatsApp API Credentials (Gupshup)
GUPSHUP_API_KEY="your_gupshup_api_key_here"

# 6. Email Password (Gmail App Password / SMTP)
SMTP_PASS="your_smtp_app_password_here"
